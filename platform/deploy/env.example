# Settings for Smitten's game-sharing site. Copy to platform/.env (git ignores
# it) or to the file the systemd unit names (/etc/smitten/env), and fill in.
# Variables set in the environment win over this file.

# --- Where it runs ---------------------------------------------------------

# The address people use. Links, cookies (Secure when https) and the check
# that requests come from the site's own pages all use it.
PUBLIC_URL=https://games.example.hackclub.app
# Nest's reverse proxy sends traffic to this port; listen on all addresses.
PORT=8787
HOST=::
# Behind a reverse proxy (Nest's, or Caddy), take the client's address from
# X-Forwarded-For. Leave it off when nothing sits in front of the server.
TRUST_PROXY=1
# Where the database, game files, backups and the generated secret live.
# Relative paths are relative to platform/.
DATA_DIR=/var/lib/smitten

# --- The editor --------------------------------------------------------------

# Where "Make a game" and "Remix" go.
EDITOR_URL=https://smitten.example.com/
# Editors (origins, comma-separated) that may sign in and publish for
# people. CORS headers go to these only.
EDITOR_ORIGINS=https://smitten.example.com

# --- Secrets -----------------------------------------------------------------

# Bearer token for /api/admin/* and scripts/admin.mjs. Admin endpoints are off
# without it. Make one with: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
ADMIN_TOKEN=
# Salts IP hashes and signs recovery codes and cookies. Without it, a random
# one is made and kept in DATA_DIR/secret. Changing it makes everyone's
# recovery codes stop working.
# SECRET=

# --- Sign in with Hack Club (optional) ---------------------------------------
# Register an app at https://auth.hackclub.com/developer/apps with the
# redirect URI <PUBLIC_URL>/auth/hackclub/callback. On when both are set.
# HACKCLUB_CLIENT_ID=
# HACKCLUB_CLIENT_SECRET=
# HACKCLUB_AUTH_URL=https://auth.hackclub.com
# HACKCLUB_SCOPE=openid

# --- Limits (these are the defaults) -----------------------------------------

# Open reports from different people that hide a game until it's reviewed.
# REPORT_THRESHOLD=3
# MAX_GAME_BYTES=26214400
# MAX_THUMBNAIL_BYTES=1048576
# Per account and hour (updates count as publishing).
# PUBLISH_LIMIT_PER_HOUR=10
# Per address (and per account, when signed in) and hour.
# REPORT_LIMIT_PER_HOUR=20
# Per address and hour.
# SIGNUP_LIMIT_PER_HOUR=5
# SIGNIN_LIMIT_PER_HOUR=30
# What games may reach with require("https"): self (only this site) or https.
# GAME_NETWORK=self
# scrypt's cost for passwords, as 2^n (15: about 50 ms and 32 MB per sign-in).
# SCRYPT_LOG_N=15
