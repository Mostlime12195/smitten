# Settings for Smitten's game-sharing site. Copy to platform/.env (git ignores
# it) or to the file the systemd unit names (/etc/smitten/env), and fill in.
# Variables set in the environment win over this file.

# --- Where it runs ---------------------------------------------------------

# The address people use. Links, cookies (Secure when https) and the check
# that requests come from the site's own pages all use it.
PUBLIC_URL=https://games.example.hackclub.app
# Nest's reverse proxy sends traffic to this port; listen on all addresses.
PORT=8787
HOST=::
# Behind a reverse proxy (Nest's, or Caddy), take the client's address from
# X-Forwarded-For, but only on connections from the proxy: 1 means from
# loopback and private addresses; or list the proxy's addresses (a trailing
# * matches a prefix: 10.0.*,fd00:*). Leave it empty when nothing sits in
# front of the server. `node scripts/admin.mjs request` shows what it sees.
TRUST_PROXY=1
# Where the database, game files, backups and the generated secret live.
# Relative paths are relative to platform/.
DATA_DIR=/var/lib/smitten

# --- The editor --------------------------------------------------------------

# Where "Make a game" and "Remix" go.
EDITOR_URL=https://smitten.example.com/
# Editors (origins, comma-separated) that may sign in and publish for
# people. CORS headers go to these only.
EDITOR_ORIGINS=https://smitten.example.com

# --- Secrets -----------------------------------------------------------------

# Bearer token for /api/admin/* and scripts/admin.mjs. Admin endpoints are off
# without it. Make one with: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
ADMIN_TOKEN=
# Salts IP hashes and signs recovery codes and cookies. Without it, a random
# one is made and kept in DATA_DIR/secret. Changing it makes everyone's
# recovery codes stop working, and disconnects Hackatime everywhere.
# SECRET=

# --- Sign in with Hack Club (optional) ---------------------------------------
# Register an app at https://auth.hackclub.com/developer/apps with the
# redirect URI <PUBLIC_URL>/auth/hackclub/callback. On when both are set.
# HACKCLUB_CLIENT_ID=
# HACKCLUB_CLIENT_SECRET=
# HACKCLUB_AUTH_URL=https://auth.hackclub.com
# HACKCLUB_SCOPE=openid

# --- Connect Hackatime (optional) --------------------------------------------
# Accounts connect Hackatime, Hack Club's time tracker: the editor gets the
# API key with one click, and game pages show the hours tracked for the game.
# Register a confidential OAuth app in Hackatime with the scopes "profile" and
# "read" and the redirect URI <PUBLIC_URL>/auth/hackatime/callback. On when
# both are set. Access tokens are stored encrypted with a key derived from
# SECRET: changing SECRET disconnects everyone (they connect again).
# HACKATIME_CLIENT_ID=
# HACKATIME_CLIENT_SECRET=
# HACKATIME_URL=https://hackatime.hackclub.com

# --- Email (optional) ----------------------------------------------------------
# Without EMAIL_TRANSPORT there's no email: accounts recover with recovery
# codes and moderators' reset links. With it, people can add an email
# (optional, never shown to anyone) to reset their password by email and get
# account notes. Nest blocks port 25; 587, 465 and HTTPS work.
#   smtp    any SMTP provider (Resend, Gmail, …) on 587 (STARTTLS) or 465 (TLS)
#   resend  Resend's HTTP API
#   log     writes messages to EMAIL_LOG_FILE (or the console): local testing
# EMAIL_TRANSPORT=resend
# The sender. Its domain must be one the provider lets you send from
# (for Resend, a domain you verified there).
# EMAIL_FROM=Smitten <no-reply@games.example.com>
#
# For resend: an API key with "sending access" only.
# RESEND_API_KEY=
#
# For smtp (Resend's SMTP: host smtp.resend.com, user "resend", the API key
# as the password):
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# tls for 465, starttls for anything else (the default follows the port);
# none only for a relay on this machine.
# SMTP_SECURE=starttls
# SMTP_USER=resend
# SMTP_PASS=
#
# For log:
# EMAIL_LOG_FILE=data/mail.log
#
# How long to wait for the mail server or API, per step.
# EMAIL_TIMEOUT_SECONDS=20

# --- Limits (these are the defaults) -----------------------------------------

# Open reports from different people that hide a game until it's reviewed.
# REPORT_THRESHOLD=3
# MAX_GAME_BYTES=26214400
# MAX_THUMBNAIL_BYTES=1048576
# Per account and hour (updates count as publishing).
# PUBLISH_LIMIT_PER_HOUR=10
# Per address (and per account, when signed in) and hour.
# REPORT_LIMIT_PER_HOUR=20
# Per address and hour.
# SIGNUP_LIMIT_PER_HOUR=5
# SIGNIN_LIMIT_PER_HOUR=30
# Leaderboards (README.md, "Leaderboards"): boards a game can have, the best
# scores a board keeps, and scores sent per hour by an account and by an address.
# BOARDS_PER_GAME=10
# BOARD_MAX_SCORES=1000
# SCORE_LIMIT_PER_HOUR=120
# SCORE_ADDRESS_LIMIT_PER_HOUR=300
# Cloud saves (README.md, "Cloud saves"; src/cloud.js): the largest value
# (64 KB at most), all the values of one game on one account, and their
# number; saves and removes, and loads and lists, per account and hour.
# CLOUD_VALUE_BYTES=65536
# CLOUD_GAME_BYTES=262144
# CLOUD_KEYS_PER_GAME=32
# CLOUD_WRITE_LIMIT_PER_HOUR=300
# CLOUD_READ_LIMIT_PER_HOUR=1200
# Online rooms (README.md, "Online rooms"; src/rooms.js). ROOMS=off turns
# them off. Players in one room (a game asks for 2 to this many), rooms one
# game can have open, connections on the server and from one address, the
# largest message (its data as JSON), messages and bytes each player can send
# per second, how long a dropped player keeps its place, how long a room can
# go without a message before it closes, and how often the server pings.
# ROOMS=on
# ROOM_MAX_PLAYERS=16
# ROOMS_PER_GAME=100
# ROOM_CONNECTIONS=1000
# ROOM_CONNECTIONS_PER_ADDRESS=8
# ROOM_MESSAGE_BYTES=8192
# ROOM_MESSAGES_PER_SECOND=30
# ROOM_BYTES_PER_SECOND=32768
# ROOM_GRACE_SECONDS=10
# ROOM_IDLE_SECONDS=900
# ROOM_PING_SECONDS=20
# What games may reach with require("https"): self (only this site) or https.
# GAME_NETWORK=self
# scrypt's cost for passwords, as 2^n (15: about 50 ms and 32 MB per sign-in).
# SCRYPT_LOG_N=15
