{
  "name": "smitten-platform",
  "version": "0.2.0",
  "private": true,
  "description": "Smitten's game-sharing site: a Node server with SQLite (node:sqlite) and game files on disk. No dependencies.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "copy-player": "sh scripts/copy-player.sh",
    "seed": "node scripts/seed.mjs",
    "admin": "node scripts/admin.mjs",
    "backup": "node scripts/backup.mjs",
    "test": "node ../tools/platform-tests/test.mjs"
  }
}
